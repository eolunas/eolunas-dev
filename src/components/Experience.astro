---
import ExperienceItem from "./ExperienceItem.astro";
import ToolIcon from "../icons/Tool.astro";

const { class: className } = Astro.props;

const EXPERIENCE = [
{
    date: { start: "Mar 2024", end: "Hoy" },
    title: "Profesional Lider IT",
    company: "Corparques - Mundo Aventura",
    location: "Bogotá, Colombia",
    description:
      "Desarrollador Full Stack especializado en .NET C# y JavaScript, con experiencia en la creación y mejora de sistemas CORE. He implementado nuevas funcionalidades, integrado periféricos, y desarrollado soluciones personalizadas para sistemas POS y módulos específicos, alineados con las necesidades de negocio.",
  },
  {
    date: { start: "Jun 2021", end: "Feb 2024" },
    title: "Programador Freelance",
    company: "Freelance",
    location: "Bogotá, Colombia",
    description:
      "Consultor especializado en ingeniería, prototipos e impresión 3D. Desarrollo de aplicaciones y sitios web personalizados según los requerimientos del cliente.",
  },
  {
    date: { start: "May 2019", end: "Feb 2021" },
    title: "Gerente ingeniería electrónica",
    company: "VC999 Packaging Systems Colombia S.A.S.",
    location: "Bogotá, Colombia",
    description:
      "Líder técnico y director de equipo de programación, responsable del diseño de interfaces de usuario, desarrollo de lógica de funcionamiento para maquinaria, y gestión integral de sistemas.",
  },
  {
    date: { start: "Feb 2017", end: "May 2019" },
    title: "Ingeniero de proyectos",
    company: "VC999 Packaging Systems Colombia S.A.S.",
    location: "Bogotá, Colombia",
    description:
      "Desarrollador responsable de la programación, implementación y puesta en marcha de equipos, además del diseño de prototipos y soluciones innovadoras de empaque.",
  },
  {
    date: { start: "Mar 2016", end: "Ene 2017" },
    title: "Ingeniero Junior",
    company: "Teppack Colombia LTDA",
    location: "Bogotá, Colombia",
    description:
      "Ingeniero multidisciplinario, encargado de brindar soporte integral en las áreas de mecánica y electrónica.",
  },
];
---

<div class={`${className}`}>
  <h2
    class={`
    flex items-center justify-center gap-x-2 text-4xl font-semibold py-4 text-gray-700
    lg:justify-start
    dark:text-white`}
  >
    <ToolIcon class="size-8" /> Experiencia
  </h2>
  <ol class={`relative border-s border-gray-200 dark:border-gray-700 ml-3`}>
    {
      EXPERIENCE.map((experience) => (
        <li class="mb-5 ms-4">
          <ExperienceItem {...experience} />
        </li>
      ))
    }
  </ol>
</div>
